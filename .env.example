# Supabase — project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — platform.claude.com
ANTHROPIC_API_KEY=

# Firecrawl — firecrawl.dev
FIRECRAWL_API_KEY=

# Voyage AI — dashboard.voyageai.com (embeddings, voyage-3.5-lite)
VOYAGE_API_KEY=
VOYAGE_EMBEDDINGS_URL="https://api.voyageai.com/v1/embeddings"

# Brevo — brevo.com (all email: notifications + newsletter campaigns).
# One-time manual setup in the Brevo dashboard before this works:
#   1. Add and verify a sender (single-sender verification needs no domain —
#      just a 6-digit code sent to that address).
#   2. Create a subscriber list, copy its numeric ID into BREVO_LIST_ID.
#      Add/import subscribers directly in the Brevo dashboard — this app
#      never invents its own subscriber signup or import flow (see
#      artifact/design.md, "Known limitations" and "Newsletter subscribers").
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Flow"
BREVO_LIST_ID=

# Discord — bot token + channel ID for the team error channel (not a webhook).
# One-time setup: create an app + bot at discord.com/developers/applications,
# invite it to the server with permission to send messages in that channel,
# then copy the bot token and the channel's ID (right-click the channel with
# Developer Mode on > Copy Channel ID).
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_API_BASE_URL="https://discord.com/api/v10"

# Secret shared with the cron sweep endpoint (POST /api/publish/run-due)
CRON_SECRET=

# Bearer token accepted by the curl-testable Route Handlers (app/api/requests/*)
# alongside a real session cookie — for producing the testing-evidence table.
# Leave unset to require a real login for those routes too.
TESTING_API_TOKEN=

# App base URL, used in notification emails and Discord alert links back
# into the app. Required — no code fallback.
APP_URL="http://localhost:3000"
